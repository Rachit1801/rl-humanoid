<mujoco>
    <option timestep="0.02"/>
    <worldbody>
        <!-- Virtual Track -->
        <geom name="track" type="box" pos="0 0 0.045" size="3.0 0.12 0.045" rgba="0 0 0 1" contype="0" conaffinity="0"/>
        <body pos="0 0 0.1">
            <joint name="cart_slider" type="slide" axis="1 0 0"/>
            <geom name="cart" type="box" size="0.2 0.15 0.1" mass="0.1" rgba="1 0 0 1"/>
            <body pos="0 0 0.1">
                <joint name="pole_hinge" type="hinge" axis="0 1 0"/>
                <geom name="pole" type="capsule" fromto="0 0 0 0 0 1" size="0.05" mass="10" rgba="0 1 0 1"/>
            </body>
        </body>
    </worldbody>
    <actuator>
        <motor joint="cart_slider" ctrlrange="-1 1" gear="10"/>
    </actuator>
    <sensor>
        <jointpos name="cart_pos" joint="cart_slider"/>
        <jointvel name="cart_vel" joint="cart_slider"/>
        <jointpos joint="pole_hinge"/>
        <jointvel joint="pole_hinge"/>
    </sensor>
</mujoco>